{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "sortPackageJson": false,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "src-alias",
        "elementNamePattern": ["@src/**"]
      },
      {
        "groupName": "component-alias",
        "elementNamePattern": ["@comp/**"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "src-alias",
      "component-alias",
      "parent",
      "sibling",
      "index",
      "unknown"
    ],
    "newlinesBetween": true
  },
  "ignorePatterns": [
    "build/",
    "coverage/",
    "node_modules/",
    "docs/",
    "backend/",
    ".github/",
    ".venv/",
    "package-lock.json"
  ]
}
