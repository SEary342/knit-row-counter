{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "react", "typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "eslint/no-unused-vars": [
      "warn",
      {
        "caughtErrors": "none",
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "build/",
    "coverage/",
    ".github/",
    "backend/",
    "docs/",
    "scripts/",
    ".vscode/",
    ".venv/"
  ]
}
