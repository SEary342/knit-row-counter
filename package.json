{
  "name": "knit-row-counter",
  "private": true,
  "version": "0.0.23",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint . --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "update-favicon": "node scripts/update-favicon.mjs",
    "release:start": "node scripts/update-and-build.mjs",
    "release:finish": "node scripts/update-and-build.mjs --finish --lint",
    "knip": "knip"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@reduxjs/toolkit": "^2.14.0",
    "immer": "^11.2.9",
    "nanoid": "^6.0.2",
    "notistack": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
