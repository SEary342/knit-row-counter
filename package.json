{
  "name": "knit-row-counter",
  "private": true,
  "version": "0.0.23",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint . --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "update-favicon": "node scripts/update-favicon.mjs",
    "release:start": "node scripts/update-and-build.mjs",
    "release:finish": "node scripts/update-and-build.mjs --finish --lint",
    "knip": "knip"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/x-data-grid": "^8.27.3",
    "@reduxjs/toolkit": "^2.11.2",
    "immer": "^11.2.9",
    "nanoid": "^6.0.2",
    "notistack": "^3.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^28.1.0",
    "knip": "^5.85.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
